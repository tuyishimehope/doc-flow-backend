app_name=DocFlow
secret_key=replace-with-a-long-random-secret
algorithm=HS256
access_token_expire_minutes=30

broker_host=redis://localhost:6379/0
broker_backend=redis://localhost:6379/1

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_INPUT_CHARS=100000
OPENAI_MAX_OUTPUT_TOKENS=2048

DATABASE_NAME=docflow
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documents
MINIO_SECURE=false
MAX_UPLOAD_SIZE_BYTES=10485760
DEPENDENCY_STARTUP_TIMEOUT_SECONDS=60

DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5433/test_docflow

mail_server=localhost
mail_port=587
mail_username=
mail_password=
mail_from=noreply@example.com
mail_use_tls=true
frontend_url=http://localhost:8000
cors_origins=["http://localhost:3000"]
rate_limit_enabled=true
processing_email_enabled=true

# Chat (OpenRouter). Leave OPENROUTER_API_KEY empty to disable chat (it answers 503).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openrouter/free
CHAT_TIMEOUT_SECONDS=30
CHAT_TOTAL_TIMEOUT_SECONDS=45
CHAT_MAX_RETRIES=2
CHAT_STREAM_TIMEOUT_SECONDS=120
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_HISTORY_MESSAGES=10
CHAT_HISTORY_MAX_CHARS=12000
CHAT_DAILY_TOKEN_BUDGET=200000
CHAT_MAX_CONCURRENT_STREAMS=2
GEMINI_AI_API_KEY=
CHAT_GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_AI_API_KEY=
CHAT_GROQ_MODEL=openai/gpt-oss-20b
CHAT_OPENAI_MODEL=gpt-3.5-turbo
CHAT_FALLBACK_MAX_RETRIES=1
CHAT_FALLBACK_TOTAL_TIMEOUT_SECONDS=90
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLE_LOGS=true
SENTRY_LOGS_LEVEL=INFO
SENTRY_DEBUG=false
# Transcription Model for speech to text
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_MAX_FILE_MB=10
TRANSCRIBE_TIMEOUT_SECONDS=60
# development shows SQL values in database errors; anything else (default production) hides them
ENVIRONMENT=production
