app_name=DocFlow
secret_key=replace-with-a-long-random-secret
algorithm=HS256
access_token_expire_minutes=30

broker_host=redis://localhost:6379/0
broker_backend=redis://localhost:6379/1

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_INPUT_CHARS=100000
OPENAI_MAX_OUTPUT_TOKENS=2048

DATABASE_NAME=docflow
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documents
MINIO_SECURE=false
MAX_UPLOAD_SIZE_BYTES=10485760
DEPENDENCY_STARTUP_TIMEOUT_SECONDS=60

DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5433/test_docflow

mail_server=localhost
mail_port=587
mail_username=
mail_password=
mail_from=noreply@example.com
mail_use_tls=true
frontend_url=http://localhost:8000
cors_origins=["http://localhost:3000"]
rate_limit_enabled=true
processing_email_enabled=true
